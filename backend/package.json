{
  "name": "intranerd-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API RESTful modular de IntraNerd: 8 módulos escolares sobre Express + SQLite (node:sqlite).",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:force": "node src/db/seed.js --force",
    "db:reset": "node src/db/seed.js --force",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  }
}
