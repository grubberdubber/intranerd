# ============================================================================
# IntraNerd · Variables de entorno
# Copia este archivo a `.env` y ajusta los valores antes de desplegar:
#   cp .env.example .env
# La base de datos es SQLite y se persiste en el volumen `backend_data`.
# ============================================================================

# --- Aplicación -------------------------------------------------------------
NODE_ENV=production
APP_PORT=8080
API_PORT=4000
TZ=America/Santiago

# --- Base de datos SQLite ---------------------------------------------------
# Ruta dentro del contenedor. En local: data/intranerd.db (backend/).
DATABASE_PATH=/app/data/intranerd.db
SEED_ON_START=true
MAX_UPLOAD_MB=10

# --- Seguridad y red --------------------------------------------------------
# En producción restringe a tu dominio: https://intranerd.tudominio.cl
CORS_ORIGINS=http://localhost:8080
# Peticiones por IP por minuto (0 desactiva).
RATE_LIMIT_MAX=300

# --- Frontend (build) -------------------------------------------------------
# Base de la API usada por la SPA; Nginx la resuelve con proxy /api.
INTRANERD_API_BASE=/api
